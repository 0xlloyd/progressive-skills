{
  "$description": "Design tokens for [SYSTEM NAME], in the W3C Design Tokens Community Group format (2025.10). Every value below is a placeholder: replace it with the user's choice and record the decision ID, label and source in $extensions. Remove groups the system doesn't use. Record motion rules that tokens can't express (signature motion, what never moves, reduced motion) in DESIGN.md.",
  "$extensions": {
    "progressive-design-system": {
      "system": "[SYSTEM NAME]",
      "version": "0.1.0",
      "updated": "YYYY-MM-DD",
      "guide": "DESIGN.md"
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.5,
            0.08,
            250
          ],
          "hex": "#000000"
        },
        "$description": "[Role in one line]",
        "$extensions": {
          "progressive-design-system": {
            "decision": "D2",
            "label": "bespoke",
            "source": "[brief | inspiration name | research finding]"
          }
        }
      }
    },
    "neutral": {
      "50": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.98,
            0.005,
            200
          ],
          "hex": "#000000"
        }
      },
      "500": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.6,
            0.01,
            200
          ],
          "hex": "#000000"
        }
      },
      "950": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.15,
            0.01,
            200
          ],
          "hex": "#000000"
        }
      }
    },
    "status": {
      "success": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.55,
            0.12,
            150
          ],
          "hex": "#000000"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.75,
            0.14,
            80
          ],
          "hex": "#000000"
        }
      },
      "error": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.55,
            0.18,
            25
          ],
          "hex": "#000000"
        }
      },
      "info": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.55,
            0.1,
            240
          ],
          "hex": "#000000"
        }
      }
    },
    "bg": {
      "$value": "{color.neutral.50}",
      "$description": "Page background"
    },
    "surface": {
      "$value": "{color.neutral.50}",
      "$description": "Cards and panels"
    },
    "text": {
      "$value": "{color.neutral.950}",
      "$description": "Body text"
    },
    "text-muted": {
      "$value": "{color.neutral.500}",
      "$description": "Secondary text"
    },
    "border": {
      "$value": "{color.neutral.500}",
      "$description": "Dividers and input borders"
    },
    "focus": {
      "$value": "{color.brand.primary}",
      "$description": "Focus rings"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "[Display face]",
          "serif"
        ],
        "$extensions": {
          "progressive-design-system": {
            "decision": "F6",
            "label": "bespoke",
            "source": "[source]",
            "licence": "[e.g. SIL OFL / commercial web licence]"
          }
        }
      },
      "text": {
        "$value": [
          "[Text face]",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "[Mono face]",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "body": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "h1": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      }
    },
    "lineHeight": {
      "$type": "number",
      "body": {
        "$value": 1.5
      },
      "heading": {
        "$value": 1.1
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "body": {
        "$value": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "typography": {
    "$type": "typography",
    "body": {
      "$value": {
        "fontFamily": "{font.family.text}",
        "fontSize": "{font.size.body}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "{font.letterSpacing.body}",
        "lineHeight": "{font.lineHeight.body}"
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.h1}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": "{font.letterSpacing.body}",
        "lineHeight": "{font.lineHeight.heading}"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": {
        "$value": {
          "value": 1,
          "unit": "px"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": {
          "colorSpace": "oklch",
          "components": [
            0.15,
            0.01,
            200
          ],
          "alpha": 0.12
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 4,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": {
        "value": 80,
        "unit": "ms"
      },
      "$description": "Press and toggle feedback"
    },
    "quick": {
      "$value": {
        "value": 160,
        "unit": "ms"
      },
      "$description": "Hover and small state changes"
    },
    "standard": {
      "$value": {
        "value": 320,
        "unit": "ms"
      },
      "$description": "Entrances, panels, page transitions"
    },
    "story": {
      "$value": {
        "value": 1200,
        "unit": "ms"
      },
      "$description": "Animated charts and social motion beats"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Most movement"
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    }
  },
  "transition": {
    "$type": "transition",
    "hover": {
      "$value": {
        "duration": "{duration.quick}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.standard}"
      }
    },
    "enter": {
      "$value": {
        "duration": "{duration.standard}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.enter}"
      }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 480,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 768,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 1200,
        "unit": "px"
      }
    }
  }
}